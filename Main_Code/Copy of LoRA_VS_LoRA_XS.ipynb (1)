:{}}]},{"cell_type":"code","source":["import math\n","\n","class LoRAXSLinear(torch.nn.Module):\n","    def __init__(self, base_linear, r=LORA_RANK, alpha=LORA_RANK):\n","        super().__init__()\n","        self.base = base_linear\n","        for p in self.base.parameters():\n","            p.requires_grad = False\n","\n","        in_features = base_linear.in_features\n","        out_features = base_linear.out_features\n","\n","        # Frozen random projections (down and up)\n","        self.lora_A = torch.nn.Parameter(torch.randn(r, in_features) / math.sqrt(r), requires_grad=False)\n","        self.lora_B = torch.nn.Parameter(torch.randn(out_features, r) / math.sqrt(r), requires_grad=False)\n","        # Only this small r x r matrix is trainable\n","        self.lora_C = torch.nn.Parameter(torch.zeros(r, r), requires_grad=True)\n","\n","        self.scaling = alpha / r\n","\n","    def forward(self, x):\n","        base_out = self.base(x)\n","        lora_out = (x @ self.lora_A.T) @ self.lora_C.T @ self.lora_B.T\n","        return base_out + self.scaling * lora_out\n","\n","\n","def replace_with_loraxs_layers(model):\n","    for n, m in model.named_children():\n","        if isinstance(m, torch.nn.Module):\n","            if hasattr(m, \"q_lin\") and hasattr(m, \"k_lin\") and hasattr(m, \"v_lin\") and hasattr(m, \"out_lin\"):\n","                m.q_lin = LoRAXSLinear(m.q_lin)\n","                m.k_lin = LoRAXSLinear(m.k_lin)\n","                m.v_lin = LoRAXSLinear(m.v_lin)\n","                m.out_lin = LoRAXSLinear(m.out_lin)\n","            else:\n","                replace_with_loraxs_layers(m)\n","\n","\n","model_loraxs = transformers.AutoModelForSequenceClassification.from_pretrained(MODEL_NAME, num_labels=2)\n","\n","for p in model_loraxs.parameters():\n","    p.requires_grad = False\n","\n","replace_with_loraxs_layers(model_loraxs)\n","\n","for n, p in model_loraxs.named_parameters():\n","    if \"classifier\" in n or \"pre_classifier\" in n:\n","        p.requires_grad = True\n","loraxs_param_count = sum(1 for n, p in model_loraxs.named_parameters() if 'lora_C' in n and p.requires_grad)\n","print(f\"Number of trainable LoRA-XS core parameters found: {loraxs_param_count}\")\n","\n","training_args_loraxs = transformers.TrainingArguments(\n","    output_dir=\"./lora_xs_results\",\n","    learning_rate=LEARNING_RATE,\n","    per_device_train_batch_size=BATCH_SIZE,\n","    num_train_epochs=NUM_EPOCHS,\n","    eval_strategy=\"epoch\",\n","    save_strategy=\"epoch\",\n","    load_best_model_at_end=True,\n","    report_to=\"none\",\n",")\n","trainer_loraxs = transformers.Trainer(\n","    model=model_loraxs,\n","    args=training_args_loraxs,\n","    train_dataset=train_dataset,\n","    eval_dataset=eval_dataset,\n","    compute_metrics=compute_metrics,\n",")\n","\n","print(\"Starting LoRA-XS training...\")\n","trainer_loraxs.train()\n","metrics_loraxs = trainer_loraxs.evaluate()\n","\n","num_trainable_loraxs = sum(p.numel() for p in model_loraxs.parameters() if p.requires_grad)\n","accuracy_loraxs = metrics_loraxs['eval_accuracy']\n","\n","print(f\"LoRA-XS Accuracy: {accuracy_loraxs:.4f}\")\n","print(f\"LoRA-XS Trainable Parameters: {num_trainable_loraxs}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":720,"referenced_widgets":["5863eb729ce645a1bb3a6b6ede3f9ea9","2f3972501a774188811859db1994117b","6c3117cfe18d4f79992f521dc4785833","2bdb9becf37845a6b6df599733ce6d37","651a3dd933b346ee8f165d08b6c44268","abcd10bef152404f86544b0229105f26","a6c87c91c2f44f4dbf8d1a392287ad7f","f56b9ffa3b0946c6b324f1f92c7e81aa","2ddcfa8e542445a48cd689951075c0a4","f4955743597d4932a617fba285ba070f","867e227afa1c45a49ca8b24ef21e7892","6c407a0062d04388b8d4fc42fd1b16b5","76bfb6e4950d461c94db28ec6ae10867","1b09b5ccdaea4a0580b92a145137b324","e9a61507bdab4365ada714e819b1ba0b","da13199a71f44a61aa971d67da2f4a2c","53ca878cb99f464c8edcbc71d71ea0aa","ea59f595de374af184855ea73c70863c","9760402a99ee4a8e83d7871a484c5956","c34f476a